# Django marketplace API (run from backend/django_api)
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace_with_a_private_random_secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CLIENT_ORIGIN=http://localhost:5173

# Configure PostgreSQL after creating a separately managed database:
# DATABASE_URL=postgresql://username:password@127.0.0.1:5432/truck_booking
# Configure Redis to enable the Celery worker:
# REDIS_URL=redis://127.0.0.1:6379/0

# Set these only when previewing/importing legacy MongoDB records:
# MONGODB_URI=mongodb://127.0.0.1:27017/truck_booking
# MONGODB_DATABASE=truck_booking

# Razorpay keys go in the private backend/.env file, never in app source.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_MAPS_API_KEY=

OTP_DEBUG_RETURN_CODE=true
OTP_RESEND_SECONDS=60
OTP_EXPIRY_MINUTES=5
COMMISSION_RATE=5.00
MATCHING_RADIUS_KM=100
# Development simulation only; disabled automatically when Django debug is off.
PAYMENT_SANDBOX_ENABLED=false
